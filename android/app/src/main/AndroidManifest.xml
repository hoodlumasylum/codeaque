<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="176" android:versionName="0.10.76">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 0.10.54: Voice talk in Chat (asked at runtime, only while the mic button is on) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Settings > Update: install the new CodeAque APK (Android shows its own prompt first) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 0.10.37 Screen time / Strict mode: keep a timer while a game is open, optionally bring Kids home back -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Screen Time Strict mode (Android 10+) may need this to bring Kids home back; Nova itself no longer draws over apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- 0.10.22 Safe contacts: each asked only when first used (Call / Import from phone) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <queries>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="com.roblox.client" />
        <package android:name="com.mojang.minecraftpe" />
        <package android:name="com.android.vending" />
        <!-- 0.10.59: SpeechRecognizer.isRecognitionAvailable / Play Store speech pack -->
        <package android:name="com.google.android.tts" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.nvidia.geforcenow" />
        <package android:name="com.android.chrome" />
        <package android:name="com.flycast.emulator" />
        <!-- 0.10.29 Downloads tile: see LibreTorrent if it is installed (no QUERY_ALL_PACKAGES) -->
        <package android:name="org.proninyaroslav.libretorrent" />
        <!-- 0.10.76: see B612 if installed so the camera icon can open it (Play Store only, no QUERY_ALL_PACKAGES) -->
        <package android:name="com.linecorp.b612.android" />
        <!-- 0.9.4: installed apps and games are found through these entries (no QUERY_ALL_PACKAGES) -->
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <!-- 0.10.21 Lock mode: other Home apps are not opened from CodeAque while locked -->
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /></intent>
        <!-- emulators that open a game file the user picked -->
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="content" android:mimeType="*/*" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="market" /></intent>
        <intent><action android:name="android.intent.action.DIAL" /><data android:scheme="tel" /></intent>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="smsto" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <!-- 0.10.59: fallback speak-now activity; required or resolveActivity is false on API 30+ -->
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
    </queries>
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- 0.10.30: adaptive icon (whole logo inside the safe zone, scripts/make_android_icons.py) and a fitted TV banner -->
    <application android:extractNativeLibs="true" android:label="CodeAque" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:banner="@drawable/banner"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" android:hardwareAccelerated="true"
        android:largeHeap="false" android:allowBackup="true" android:requestLegacyExternalStorage="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:stateNotNeeded="true" android:excludeFromRecents="true" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- 0.10.1: HOME and the app-drawer entries in separate filters; one combined filter made some ROMs
                 (GammaOS / Android 12 with Daijisho + Trebuchet) forget "Always" and show the Home chooser again -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- 0.10.30: long-press shortcuts (Adult mode, Settings); both ask for the parent PIN first -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!-- 0.10.30: extra home-screen icons. Each opens CodeAque and asks for the parent PIN, then goes to Adult mode
             or Settings. MainActivity turns both off while Lock Mode is on and back on when it is turned off. -->
        <activity-alias android:name=".AdultAlias" android:targetActivity=".MainActivity" android:exported="true"
            android:label="CodeAque Adult" android:icon="@mipmap/ic_launcher_adult" android:roundIcon="@mipmap/ic_launcher_adult_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".SettingsAlias" android:targetActivity=".MainActivity" android:exported="true"
            android:label="CodeAque Settings" android:icon="@mipmap/ic_launcher_settings" android:roundIcon="@mipmap/ic_launcher_settings_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- 0.10.37: optional device owner kiosk. On a freshly reset phone with no accounts:
             adb shell dpm set-device-owner com.codeaque.launcher/.AdminReceiver
             (or Settings > Lock phone to CodeAque, which uses su on a rooted phone). -->
        <receiver android:name=".AdminReceiver" android:exported="true" android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter><action android:name="android.app.action.DEVICE_ADMIN_ENABLED" /></intent-filter>
        </receiver>
        <!-- Older adb command still works: dpm set-device-owner com.codeaque.launcher/.CodeAqueAdmin -->
        <receiver android:name=".CodeAqueAdmin" android:exported="true" android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter><action android:name="android.app.action.DEVICE_ADMIN_ENABLED" /></intent-filter>
        </receiver>
        <!-- 0.10.22 optional: Block unknown callers / Only call safe numbers (Android 10+ roles the parent grants) -->
        <service android:name=".SafeCallScreening" android:exported="true" android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter><action android:name="android.telecom.CallScreeningService" /></intent-filter>
        </service>
        <service android:name=".SafeCallRedirection" android:exported="true" android:permission="android.permission.BIND_CALL_REDIRECTION_SERVICE">
            <intent-filter><action android:name="android.telecom.CallRedirectionService" /></intent-filter>
        </service>
        <!-- 0.10.37: Kids screen time and Strict-mode watcher. Not exported. -->
        <service android:name=".ScreenTimeService" android:exported="false" android:foregroundServiceType="specialUse" />
        <!-- 0.10.58: stub only — stops a leftover 0.10.57 overlay on update. Nova stays in CodeAque. -->
        <service android:name=".NovaOverlayService" android:exported="false" />
        <!-- 0.10.58: optional hands-free listen while Nova is hidden. Voice only, no overlay window. -->
        <service android:name=".NovaListenService" android:exported="false" android:foregroundServiceType="microphone" />
    </application>
</manifest>
